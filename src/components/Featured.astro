---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import BeforeAfter from './BeforeAfter.tsx';

const p = (await getCollection('projects')).find((x) => x.data.featured)!;
const frames = p.data.gallery.slice(0, 6);
const lifted = 1; // el fotograma «levantado»

const ba = p.data.beforeAfter;
const toProps = async (src: ImageMetadata) => {
  const img = await getImage({ src, widths: [800, 1280, 1920], format: 'avif' });
  return { src: img.src, srcSet: img.srcSet.attribute, width: Number(img.attributes.width ?? src.width), height: Number(img.attributes.height ?? src.height) };
};
const baProps = ba && { before: await toProps(ba.before), after: await toProps(ba.after), alt: ba.alt, demo: ba.demo };
---

<section class="overflow-x-clip bg-surface py-28 md:py-40" aria-labelledby="destacado">
  <div class="wrap grid-12 gap-y-10">
    <div class="col-span-12 flex flex-col md:col-span-3" data-reveal>
      <h2 id="destacado" class="text-title">{p.data.name}</h2>
      <a href={`/proyectos/${p.id}`} class="link-u mt-4 self-start">Ver el proyecto</a>
      <p class="mt-10 max-w-[30ch] md:mt-auto">{p.data.summary}</p>
      <p class="mt-4 text-note">{p.data.location} · {p.data.year} · {p.data.areaM2} m² · {p.data.scope}</p>
    </div>

    <div class="col-span-12 -mr-[5vw] md:col-span-9" data-frames>
      <!-- Región desplazable: enfocable con Tab, se recorre con las flechas del teclado -->
      <ul
        class="frame-run flex snap-x snap-mandatory items-end gap-[6px] overflow-x-auto pb-2 focus-visible:outline-offset-[-3px]"
        tabindex="0"
        aria-label={`Fotos de ${p.data.name}`}
        data-reveal
      >
        {
          frames.map((f, i) => (
            <li class:list={['shrink-0 snap-start', i === lifted ? 'order-first md:order-none' : '']}>
              <div class:list={['media relative', i === lifted ? 'aspect-[3/4] h-[56vw] md:h-[62vh]' : 'aspect-[4/3] h-[34vw] md:h-[28vh]']}>
                <Image format="avif" src={f.src} alt={f.alt} widths={[480, 900, 1400]} sizes={i === lifted ? '50vw' : '25vw'} class="h-full w-full object-cover" />
                {i === lifted && <span class="dot absolute top-4 left-4" aria-hidden="true" />}
              </div>
            </li>
          ))
        }
      </ul>
      <div class="frame-nav mt-4 flex gap-6 pr-[5vw] text-note" hidden>
        <button type="button" class="link-u min-h-11 cursor-pointer disabled:cursor-default disabled:no-underline disabled:text-muted" data-dir="-1" aria-label="Fotos anteriores">Anterior</button>
        <button type="button" class="link-u min-h-11 cursor-pointer disabled:cursor-default disabled:no-underline disabled:text-muted" data-dir="1" aria-label="Fotos siguientes">Siguiente</button>
      </div>
    </div>

    {
      baProps && (
        <div class="col-span-12 mt-16 md:col-span-10 md:col-start-3 md:mt-28" data-reveal>
          <p class="mb-6 max-w-[40ch] text-statement leading-[1.2]">Arrastra el punto: el mismo patio, antes y después.</p>
          <BeforeAfter client:visible {...baProps} />
          <noscript>
            <div class="grid grid-cols-2 gap-2">
              <img src={baProps.before.src} alt={`${ba!.alt}: antes`} />
              <img src={baProps.after.src} alt={`${ba!.alt}: después`} />
            </div>
          </noscript>
        </div>
      )
    }
  </div>
</section>

<style>
  .frame-run { scrollbar-width: none; }
  .frame-run::-webkit-scrollbar { display: none; }
</style>

<script>
  // Controles para quien no tiene desplazamiento horizontal (ratón sin trackpad, teclado).
  function setupFrames() {
    document.querySelectorAll<HTMLElement>('[data-frames]').forEach((root) => {
      const run = root.querySelector<HTMLElement>('.frame-run');
      const nav = root.querySelector<HTMLElement>('.frame-nav');
      if (!run || !nav) return;
      const [prev, next] = [...nav.querySelectorAll<HTMLButtonElement>('button')];
      const sync = () => {
        const max = run.scrollWidth - run.clientWidth;
        nav.hidden = max < 4;
        prev.disabled = run.scrollLeft < 4;
        next.disabled = run.scrollLeft > max - 4;
      };
      nav.addEventListener('click', (e) => {
        const btn = (e.target as Element).closest<HTMLButtonElement>('button[data-dir]');
        if (!btn) return;
        const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
        run.scrollBy({ left: Number(btn.dataset.dir) * run.clientWidth * 0.8, behavior: smooth ? 'smooth' : 'auto' });
      });
      run.addEventListener('scroll', sync, { passive: true });
      // Observa el propio nodo (no window): no se acumulan oyentes entre navegaciones del ClientRouter.
      new ResizeObserver(sync).observe(run);
    });
  }
  document.addEventListener('astro:page-load', setupFrames);
</script>
