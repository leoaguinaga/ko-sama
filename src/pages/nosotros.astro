---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Founder from '../components/Founder.astro';
import Studio from '../components/Studio.astro';
import Process from '../components/Process.astro';
import Clients from '../components/Clients.astro';
import Onward from '../components/Onward.astro';
import Footer from '../components/Footer.astro';
import { founder } from '../data/site';
---

<Layout
  title={`${founder.name}, ${founder.title.toLowerCase()} · Ko-Sama`}
  description={`${founder.name} es arquitecto y fundó Ko-Sama en Chiclayo en 2014. Su estudio, cómo trabaja y quiénes han confiado en él.`}
>
  <div>
    <Header />
    <main id="contenido">
      <Founder />
      <Studio />
      <Process />
      <Clients />
      <Onward to={['contacto']} statement={`Cuéntale a ${founder.firstName} de tu terreno. Te respondemos con una visita.`} />
    </main>
  </div>
  <Footer />
</Layout>
