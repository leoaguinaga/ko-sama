---
import { Image, getImage } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BeforeAfter from '../../components/BeforeAfter.tsx';
import { whatsappLink } from '../../data/site';

export async function getStaticPaths() {
  const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return all.map((p, i) => ({ params: { slug: p.id }, props: { p, next: all[(i + 1) % all.length] } }));
}

interface Props {
  p: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}
const { p, next } = Astro.props;
const d = p.data;

const og = await getImage({ src: d.cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const toProps = async (src: ImageMetadata) => {
  const img = await getImage({ src, widths: [800, 1280, 1920], format: 'webp' });
  return { src: img.src, srcSet: img.srcSet.attribute, width: src.width, height: src.height };
};
const ba = d.beforeAfter && { before: await toProps(d.beforeAfter.before), after: await toProps(d.beforeAfter.after), alt: d.beforeAfter.alt, demo: d.beforeAfter.demo };

const facts = [
  ['Ubicación', d.location],
  ['Año', String(d.year)],
  ['Área', `${d.areaM2.toLocaleString('es-PE')} m²`],
  ['Tipo', d.type],
  ['Alcance', d.scope],
  ...(d.client ? [['Cliente', d.client]] : []),
];
// Galería en tamaños desiguales: ancho, vertical, vertical, ancho…
const spans = ['md:col-span-12 aspect-[21/9]', 'md:col-span-5 aspect-[4/5]', 'md:col-span-6 md:col-start-7 aspect-[4/5] md:mt-32', 'md:col-span-8 md:col-start-3 aspect-[16/10]'];
---

<Layout title={`${d.name} · Ko-Sama`} description={d.summary} image={og.src}>
  <Header current="proyectos" />
  <main id="contenido">
    <section class="wrap grid-12 gap-y-6 pt-20 pb-12 md:pt-32" data-reveal>
      <h1 class="col-span-12 text-display md:col-span-8">{d.name}</h1>
      <p class="col-span-12 max-w-[34ch] text-statement leading-[1.2] md:col-span-4 md:self-end">{d.summary}</p>
    </section>

    <div class="media h-[70svh] md:h-[88svh]">
      <Image src={d.cover} alt={d.coverAlt} widths={[900, 1600, 2400]} sizes="100vw" loading="eager" fetchpriority="high" class="h-full w-full object-cover" transition:name={`cover-${p.id}`} />
    </div>

    <section class="wrap grid-12 gap-y-12 py-24 md:py-36">
      <dl class="col-span-12 grid grid-cols-2 gap-x-6 gap-y-5 md:col-span-4" data-reveal>
        {facts.map(([k, v]) => (
          <div>
            <dt class="text-note text-muted">{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
      <div class="col-span-12 space-y-6 md:col-span-6 md:col-start-7" data-reveal>
        {d.body.map((t, i) => <p class={i === 0 ? 'text-statement leading-[1.25]' : ''}>{t}</p>)}
      </div>
    </section>

    <section class="wrap grid-12 gap-y-6 md:gap-y-10" aria-label="Galería">
      {
        d.gallery.map((g, i) => (
          <figure class:list={['media col-span-12', spans[i % spans.length]]} data-unveil>
            <Image src={g.src} alt={g.alt} widths={[700, 1200, 2000]} sizes="(min-width: 768px) 70vw, 100vw" class="h-full w-full object-cover" />
          </figure>
        ))
      }
    </section>

    {
      ba && (
        <section class="wrap grid-12 py-24 md:py-36">
          <div class="col-span-12 md:col-span-10 md:col-start-2" data-reveal>
            <p class="mb-6 text-statement">Antes y después</p>
            <BeforeAfter client:visible {...ba} />
          </div>
        </section>
      )
    }

    <section class="wrap grid-12 gap-y-10 py-24 md:py-36">
      <div class="col-span-12 md:col-span-6" data-reveal>
        <p class="max-w-[22ch] text-statement leading-[1.2]">¿Tienes un lugar parecido? Conversemos.</p>
        <div class="mt-8 flex flex-wrap items-center gap-5">
          <a href="/#contacto" class="btn-dot">Agenda una visita</a>
          <a href={whatsappLink(`Hola Ko-Sama, vi el proyecto ${d.name} y quiero conversar.`)} class="link-u">Escribir por WhatsApp</a>
        </div>
      </div>
      <a href={`/proyectos/${next.id}`} class="group col-span-12 md:col-span-5 md:col-start-8" data-reveal>
        <p class="text-note text-muted">Siguiente proyecto</p>
        <p class="mb-4 text-title">{next.data.name}</p>
        <div class="media aspect-[3/2]">
          <Image src={next.data.cover} alt={next.data.coverAlt} widths={[600, 1000]} sizes="40vw" class="h-full w-full object-cover" />
        </div>
      </a>
    </section>
  </main>
  <Footer />
</Layout>
